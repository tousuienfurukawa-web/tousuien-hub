                  "type": "text",
                  "text": "\nタイのtachu houseより注文がありました。\n"
                },
                {
                  "type": "text",
                  "text": "TSE-TAC-033-23_invoice（発送：EMS）",
                  "style": {
                    "bold": true
                  }
                },
